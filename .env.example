# ===== App =====
APP_PORT=8080
LLM_PROVIDER=cloud              # cloud | private
JWT_SECRET=replace-with-random-string
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# ===== MySQL（应用库） =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=qa_agent
MYSQL_USER=qa_app
MYSQL_PASSWORD=

# ===== MySQL（合成业务库，只读） =====
BIZ_MYSQL_DB=student_mental_health
BIZ_MYSQL_USER=qa_ro
BIZ_MYSQL_PASSWORD=

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== PostgreSQL + pgvector =====
PG_HOST=localhost
PG_PORT=5432
PG_DB=qa_vector
PG_USER=qa_vector
PG_PASSWORD=
EMBEDDING_DIMENSION=1024

# ===== DeepSeek（cloud） =====
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_DEEP_MODEL=deepseek-v4-pro

# ===== vLLM（private，W6） =====
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=not-needed
VLLM_CHAT_MODEL=

# ===== Ollama Embedding =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# ===== Search =====
SEARCH_PROVIDER=mock            # mock | searxng | bocha | tavily
SEARXNG_BASE_URL=http://localhost:8088
SEARXNG_TIMEOUT_SECONDS=8
BOCHA_API_KEY=
TAVILY_API_KEY=

# ===== Upload =====
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
